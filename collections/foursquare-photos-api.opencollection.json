              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get Place Photos"
        }
      ]
    }
  ],
  "bundled": true
}