{
  "opencollection": "1.0.0",
  "info": {
    "name": "Foursquare Places Ask Autocomplete API",
    "version": "2025-06-17"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Autocomplete",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Autocomplete Query Suggestions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://places-api.foursquare.com/autocomplete",
            "headers": [
              {
                "name": "X-Places-Api-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query"
              },
              {
                "name": "ll",
                "value": "",
                "type": "query"
              },
              {
                "name": "radius",
                "value": "",
                "type": "query"
              },
              {
                "name": "types",
                "value": "",
                "type": "query",
                "description": "Comma-separated set such as place,address,geo."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Return type-ahead suggestions for places, addresses, and geographies."
        }
      ]
    }
  ],
  "bundled": true
}